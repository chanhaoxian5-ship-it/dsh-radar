# Public source allowlist; local evidence/data remain on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/icon.svg
!/locale/
!/locale/*.json
!/package-lock.json
!/requirements.txt
!/cordis.patch.yml
!/lib/
!/radar/
!/skills/
!/tests/
!/docs/
/docs/*
!/docs/api/
!/docs/install.md
!/docs/verification.md
**/__pycache__/
**/*.pyc
**/*.sqlite3*
**/*.token
**/.env*
**/node_modules/

# Publish only the portable alpha.9 acceptance summary.
!/docs/acceptance/
/docs/acceptance/*
!/docs/acceptance/alpha.9.md
